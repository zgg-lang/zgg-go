// 运算符、优先级与特殊表达式
t := import('./framework')

t.test('operator: 算术运算', () => {
    t.assertEq(1 + 2, 3)
    t.assertEq(5 - 3, 2)
    t.assertEq(2 * 3, 6)
    t.assertEq(7 / 2, 3)
    t.assertEq(7 % 3, 1)
    t.assertEq(2 ** 10, 1024)
    t.assertEq(-2 ** 2, 4)
    t.assertEq(2 ** 3 ** 2, 512)
})

t.test('operator: 字符串与数组重载', () => {
    t.assertEq('ab' + 'cd', 'abcd')
    t.assertEq('ab' + 1, 'ab1')
    t.assertEq(1 + 'ab', '1ab')
    t.assertEq('ab' * 3, 'ababab')
    t.assertEq([1] + [2], [1, 2])
    t.assertEq([1, 2] * 2, [1, 2, 1, 2])
})

t.test('operator: 数值自动提升', () => {
    t.assertEq(1 + 1.5, 2.5)
    t.assertEq(typeName(1 + 1.5), '<type Float>')
    t.assertEq(typeName(1 + 1L), '<type BigNum>')
})

t.test('operator: 比较运算', () => {
    t.assertTrue(1 < 2)
    t.assertTrue(2 <= 2)
    t.assertTrue(3 > 2)
    t.assertTrue(3 >= 3)
    t.assertTrue(1 != 2)
    t.assertTrue([1, 2] == [1, 2])
    t.assertTrue({a: 1} == {a: 1})
    t.assertFalse(1 == true)
})

t.test('operator: 不支持链式比较（左结合）', () => {
    t.assertEq(1 < 2 < 3, false)
    t.assertTrue(1 < 2 && 2 < 3)
})

t.test('operator: 逻辑运算返回操作数', () => {
    t.assertEq(1 && 2, 2)
    t.assertEq(0 || 'x', 'x')
    t.assertEq(nil || 'default', 'default')
    t.assertTrue(!0)
    t.assertTrue(!'')
    t.assertEq(!!'x', true)
})

t.test('operator: 位运算', () => {
    t.assertEq(1 & 3, 1)
    t.assertEq(1 | 2, 3)
    t.assertEq(5 ^ 1, 4)
    t.assertEq(~0, -1)
    t.assertEq(1 << 3, 8)
    t.assertEq(-8 >> 1, -4)
})

t.test('operator: 优先级（与常见语言不同处）', () => {
    t.assertEq(1 + 2 * 3 ** 2, 19)
    t.assertEq(1 + 2 << 1, 6)
    t.assertEq(1 | 2 ^ 3, 0)
    t.assertEq(2 & 3 == 3, false)
})

t.test('operator: 三元与空值合并', () => {
    t.assertEq(1 > 0 ? 'yes' : 'no', 'yes')
    t.assertEq(nil ?? 'd', 'd')
    t.assertEq(undefined ?? 0, 0)
    t.assertEq(0 ?? 5, 0)
    t.assertEq(nil ?? 1 ?? 2, 1)
})

t.test('operator: 可选调用 ?.', () => {
    f := nil
    t.assertUndefined(f?.(1))
    o := {}
    t.assertUndefined(o.missing?.(1))
})

t.test('operator: ! 解包 (value, error)', () => {
    t.assertEq([1, 2]!, 1)
    t.assertEq([1, 2, 3]!, [1, 2])
    t.assertUndefined([1]!)
    os := import('gostd/os')
    t.assertThrows(() => {
        f := os.Open('/no/such/file-for-unittest')!
    }, 'assert error fail')
})

t.test('operator: % 占位符偏应用', () => {
    func add(a, b) { return a + b }
    inc := add(%, 1)
    t.assertEq(inc(10), 11)
})

t.test('operator: 区间与 in', () => {
    t.assertTrue(3 in 1..5)
    t.assertFalse(5 in 1..<5)
    t.assertTrue(2 in [1, 2, 3])
    t.assertTrue('b' in 'abc')
    t.assertFalse('z' in 'abc')
})

if isMain {
    t.run()
}
