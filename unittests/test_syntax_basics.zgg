// 基本语法：变量、字面量、作用域、类型与空值
t := import('./framework')

t.test('syntax: 声明、赋值、复合赋值与自增', () => {
    a := 1
    a = 2
    a += 3
    a -= 1
    a *= 2
    a /= 2
    a++
    a--
    t.assertEq(a, 4)
})

t.test('syntax: 块级作用域与变量遮蔽', () => {
    x := 1
    {
        x := 2
        t.assertEq(x, 2)
    }
    t.assertEq(x, 1)
})

t.test('syntax: 同作用域重复声明会报错', () => {
    t.assertThrows(() => {
        y := 1
        y := 2
    }, 'redefined')
})

t.test('syntax: 未声明变量赋值会报错', () => {
    t.assertThrows(() => {
        notDeclared = 1
    }, 'not exists')
})

t.test('syntax: 读取未声明变量得到 undefined', () => {
    t.assertUndefined(noSuchVariable)
})

t.test('syntax: 下划线作为丢弃占位', () => {
    [_, b] := [1, 2]
    t.assertEq(b, 2)
    _ := 123
    t.assertUndefined(_)
})

t.test('syntax: 数组解构', () => {
    [a, b, c] := [1, 2, 3]
    t.assertEq([a, b, c], [1, 2, 3])
})

t.test('syntax: 中文字符串与中文标识符', () => {
    名字 := '张三'
    t.assertEq(名字, '张三')
})

t.test('syntax: 三种注释', () => {
    // 行注释
    # 井号注释
    /* 块注释
       跨行 */
    t.assertEq(1, 1)
})

t.test('syntax: 数值字面量（十进制/十六进制/二进制/八进制/浮点/科学计数）', () => {
    t.assertEq(42, 42)
    t.assertEq(0x2A, 42)
    t.assertEq(0b101010, 42)
    t.assertEq(052, 42)
    t.assertEq(1.5, 1.5)
    t.assertEq(1.5e3, 1500.0)
})

t.test('syntax: 大数（BigNum）', () => {
    big := 123456789012345678901234567890L
    t.assertEq(typeName(big), '<type BigNum>')
    t.assertEq(big + 1, 123456789012345678901234567891L)
})

t.test('syntax: 字符串插值与嵌套', () => {
    name := 'zgg'
    t.assertEq('hello $name', 'hello zgg')
    t.assertEq('1 + 2 = ${1 + 2}', '1 + 2 = 3')
    t.assertEq('${name + '(${1 + 1})'}', 'zgg(2)')
})

t.test('syntax: 多行字符串与原始字符串', () => {
    multi := 'a
b'
    t.assertEq(multi, 'a\nb')
    t.assertEq(r'C:\path\n', 'C:\\path\\n')
    t.assertEq('''raw $x''', r'raw $x')
})

t.test('syntax: 转义字符', () => {
    t.assertEq('\t\n\\\'', '\t\n\\\'')
    t.assertEq('\u4f60', '你')
    t.assertEq('\x41', 'A')
})

t.test('syntax: 真值规则', () => {
    falsy := [false, 0, 0.0, '', [], {}, nil, undefined]
    for v in falsy {
        t.assertFalse(v, 'expected falsy: ' + str(v))
    }
    truthy := [1, -1, 'x', [0], {a: 1}, func() {}]
    for v in truthy {
        t.assertTrue(v, 'expected truthy: ' + str(v))
    }
})

t.test('syntax: nil 与 undefined 的区分', () => {
    t.assertEq(nil == undefined, false)
    t.assertEq(str(nil), 'nil')
    t.assertEq(str(undefined), 'undefined')
    t.assertEq(nil == nil, true)
})

t.test('syntax: 类型判断 is / type / typeName', () => {
    t.assertTrue(1 is Int)
    t.assertFalse(1 is Float)
    t.assertTrue('x' is Str)
    t.assertTrue([1] is Array)
    t.assertTrue({a: 1} is Object)
    t.assertTrue(nil is Nil)
    t.assertTrue(undefined is Undefined)
    t.assertEq(type(1).__name__, 'Int')
    t.assertEq(typeName(1), '<type Int>')
    t.assertEq(type(1) == Int, true)
})

t.test('syntax: 结构相等与跨数值比较', () => {
    t.assertEq(1 == 1.0, true)
    t.assertEq(1 == true, false)
    t.assertEq('1' == 1, false)
    t.assertEq([1, [2]] == [1, [2]], true)
    t.assertEq({a: 1} == {a: 1}, true)
})

t.test('syntax: 整数溢出回绕', () => {
    t.assertEq(9223372036854775807 + 1, -9223372036854775807 - 1)
})

t.test('syntax: 整数除法、取模与除零', () => {
    t.assertEq(7 / 2, 3)
    t.assertEq(-7 / 2, -3)
    t.assertEq(7 % 3, 1)
    t.assertEq(-7 % 3, -1)
    t.assertThrows(() => { x := 1 / 0 }, 'division by zero')
})

t.test('syntax: 数组与字符串切片', () => {
    a := [1, 2, 3, 4, 5]
    t.assertEq(a[1:3], [2, 3])
    t.assertEq(a[:2], [1, 2])
    t.assertEq(a[3:], [4, 5])
    t.assertEq('abcdef'[1:3], 'bc')
})

t.test('syntax: 对象字面量简写、计算键与展开', () => {
    name := 'zgg'
    o := {name, ['k' + '1']: 1, greet() { return 'hi' }}
    t.assertEq(o.name, 'zgg')
    t.assertEq(o.k1, 1)
    t.assertEq(o.greet(), 'hi')
    merged := {...{a: 1}, b: 2}
    t.assertEq(merged, {a: 1, b: 2})
})

t.test('syntax: 越界下标返回 undefined', () => {
    t.assertUndefined([1, 2][5])
    t.assertUndefined('ab'[9])
})

if isMain {
    t.run()
}
